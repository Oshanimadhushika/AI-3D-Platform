# frontend/.env.example
# Copy this file to .env.local for local development.
# In Vercel: add these as Environment Variables in the project settings.

# ── API Endpoints ─────────────────────────────────────────────────
# Local development
# NEXT_PUBLIC_API_URL=http://localhost:3001
# NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000

# Production — replace with your actual Render service URLs
NEXT_PUBLIC_API_URL=https://ai3d-backend.onrender.com
NEXT_PUBLIC_AI_SERVICE_URL=https://ai3d-python.onrender.com
