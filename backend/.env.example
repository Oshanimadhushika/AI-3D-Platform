# backend/.env.example
# Copy this file to .env and fill in your values.
# NEVER commit the .env file — it is already in .gitignore.

# ── Rails ──────────────────────────────────────────────────────────
# Generate with: bundle exec rails secret
SECRET_KEY_BASE=your_secret_key_base_here

# Production only — also used as Render RAILS_MASTER_KEY env var
# RAILS_MASTER_KEY=your_master_key_here

# ── Database (Supabase PostgreSQL) ────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── Active Storage (AWS S3) ───────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
AWS_BUCKET=your-s3-bucket-name

# ── AI Service ────────────────────────────────────────────────────
# URL of the deployed FastAPI service (set after deploying ai3d-python on Render)
AI_SERVICE_URL=https://ai3d-python.onrender.com

# ── Rails Host (used for generating absolute URLs in production) ──
RAILS_HOST=ai3d-backend.onrender.com

# ── Puma / Rails ──────────────────────────────────────────────────
RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
RAILS_MAX_THREADS=5
PORT=3001
