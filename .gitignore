# Root .gitignore for monorepo

# Frontend (Next.js)
frontend/node_modules/
frontend/.next/
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Backend (Rails)
backend/bin/
backend/log/*.log
backend/tmp/
backend/db/*.sqlite3
backend/db/*.sqlite3-journal
backend/vendor/bundle/
backend/.bundle/
backend/.env

# AI Service (FastAPI)
ai-service/__pycache__/
ai-service/*.py[cod]
ai-service/*.so
ai-service/.env
ai-service/venv/
ai-service/.venv/
ai-service/.python-version
ai-service/.pytest_cache/

# OS and Editors
.DS_Store
.vscode/
.idea/
*.swp
*.swo
node_modules/
.next/
dist/
build/
.env
.env.local
