# Root .gitignore for monorepo

# ── ALL .env files with secrets (NEVER commit these) ─────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── ALLOW .env.example templates (safe to commit) ───────────────
!.env.example
!**/.env.example

# Frontend (Next.js)
frontend/node_modules/
frontend/.next/

# Backend (Rails)
backend/bin/
backend/log/*.log
backend/tmp/
backend/db/*.sqlite3
backend/db/*.sqlite3-journal
backend/vendor/bundle/
backend/.bundle/
backend/storage/

# AI Service (FastAPI)
ai-service/__pycache__/
ai-service/*.py[cod]
ai-service/*.so
ai-service/venv/
ai-service/.venv/
ai-service/.python-version
ai-service/.pytest_cache/

# OS and Editors
.DS_Store
.vscode/
.idea/
*.swp
*.swo
node_modules/
.next/
dist/
build/
